{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "hide.kapsiv.com"
        }
      ],
      "destination": "/hide/index.html"
    },
    {
      "source": "/albums",
      "destination": "/albums/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/lastfm-ingest",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/puregym-ingest",
      "schedule": "0 1 * * *"
    }
  ]
}
