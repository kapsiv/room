{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/albums",
      "destination": "/albums/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/lastfm-ingest",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/puregym-ingest",
      "schedule": "0 1 * * *"
    }
  ]
}
