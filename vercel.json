{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "hide.kapsiv.com"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://www.kapsiv.com/hide"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "hide.kapsiv.com"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://www.kapsiv.com/hide"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "cv.kapsiv.com"
        }
      ],
      "destination": "/CV-July-2026.pdf"
    },
    {
      "source": "/hide",
      "destination": "/hide.html"
    },
    {
      "source": "/hide/",
      "destination": "/hide.html"
    },
    {
      "source": "/albums",
      "destination": "/albums/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/hide/index.html",
      "destination": "/hide",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/lastfm-ingest",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/puregym-ingest",
      "schedule": "0 1 * * *"
    }
  ]
}
