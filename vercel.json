{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "hide.kapsiv.com"
        }
      ],
      "dest": "/hide/index.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "hide.kapsiv.com"
        }
      ],
      "dest": "/hide/index.html"
    }
  ],
  "rewrites": [
    {
      "source": "/albums",
      "destination": "/albums/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/lastfm-ingest",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/puregym-ingest",
      "schedule": "0 1 * * *"
    }
  ]
}
